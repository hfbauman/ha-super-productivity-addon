    "panel_icon": "mdi:calendar-check",
    "ports": {
      "3000/tcp": null 
    },
    "ports_description": {
      "3000/tcp": "Super Productivity UI (Ingress-only)"
    },
    "map": ["config:rw", "share:rw"],
    "options": {
      "username": "admin",
      "password": "password"
    },
    "schema": {
      "username": "str",
      "password": "password"
    },
    "init": false
  }
  