{
    "name": "Super Productivity",
    "version": "1.0.1",
    "slug": "super_productivity",
    "description": "Super Productivity with WebDAV support",
    "arch": ["aarch64", "amd64", "armhf", "armv7"],
    "startup": "system",
    "boot": "auto",
    "ingress": true,
    "ingress_port": 3000,
